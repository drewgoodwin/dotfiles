  {
    "plugin_id": "ray.file-explorer",
    "name": "Yazi Explorer",
    "version": "1.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Open Yazi (terminal file manager) in a herdr pane",
    "manifest_path": "/home/drew/stow/herdr/.config/herdr/plugins/github/ray.file-explorer-921f378e3e1b/herdr-plugin.toml",
    "plugin_root": "/home/drew/stow/herdr/.config/herdr/plugins/github/ray.file-explorer-921f378e3e1b",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "build": [
      {
        "command": [
          "bash",
          "-c",
          "command -v yazi >/dev/null 2>&1 || { [ \"$(uname -s)\" = \"Darwin\" ] && command -v brew >/dev/null 2>&1 && exec brew install yazi; echo \"Yazi is required. Install it from https://yazi-rs.github.io/docs/installation\" >&2; exit 1; }"
        ]
      }
    ],
    "actions": [
      {
        "id": "open",
        "title": "Open file explorer",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "DIR=\"$(bash \"$HERDR_PLUGIN_ROOT/bin/resolve-dir.sh\")\"; exec \"${HERDR_BIN_PATH:-herdr}\" plugin pane open --plugin ray.file-explorer --entrypoint explorer --placement split --cwd \"$DIR\""
        ]
      },
      {
        "id": "open-tab",
        "title": "Open file explorer (new tab)",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "DIR=\"$(bash \"$HERDR_PLUGIN_ROOT/bin/resolve-dir.sh\")\"; exec \"${HERDR_BIN_PATH:-herdr}\" plugin pane open --plugin ray.file-explorer --entrypoint explorer --placement tab --cwd \"$DIR\""
        ]
      }
    ],
    "panes": [
      {
        "id": "explorer",
        "title": "Explorer",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec yazi"
        ]
      }
    ],
    "source": {
      "kind": "github",
